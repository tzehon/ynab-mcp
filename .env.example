# Explicit local-only fixture mode. No .env file is automatically loaded.
LOCAL_FIXTURE_MODE=true
DATA_MODE=fixtures
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FIXTURE_ALLOWED_PLAN_IDS=["fixture-plan-sgd"]
# Public fixture material only; use smoke:auth-fixtures for automatic test setup.
AUTH_ISSUER=https://issuer.example.test/
AUTH_AUDIENCE=http://127.0.0.1:3000/mcp
MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp
AUTH_ALLOWED_SUBJECT=synthetic-owner
AUTH_FIXTURE_FILE=/absolute/private/scratch/public.json
