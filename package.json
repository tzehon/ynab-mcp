{
  "name": "ynab-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:pr": "node scripts/check-pr-metadata.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint --error-on-warnings src scripts test",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js",
    "smoke:mcp": "node scripts/smoke-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "typescript": "7.0.2",
    "@types/node": "26.6.6",
    "@biomejs/biome": "2.6.6"
  }
}
