{
  "name": "ynab-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:pr": "node scripts/check-pr-metadata.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint --error-on-warnings src scripts test",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:auth-fixtures": "node scripts/auth-fixture-smoke.mjs",
    "smoke:auth-integrated": "node scripts/integrated-auth-smoke.mjs",
    "check:container": "node scripts/check-container.mjs",
    "smoke:auth-hosted": "npm run build && node --test test/hosted-smoke.test.mjs",
    "preview:spending": "node scripts/export-spending-preview.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.15",
    "oauth4webapi": "3.8.8",
    "oidc-provider": "9.13.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "@types/oidc-provider": "9.13.1",
    "typescript": "7.0.2"
  }
}
